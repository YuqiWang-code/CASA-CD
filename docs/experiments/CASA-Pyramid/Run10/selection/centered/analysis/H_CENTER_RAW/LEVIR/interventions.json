  "definitions": {
    "global_off": "Zero the global residual gamma; retain local detail and TAR.",
    "shuffle_attention": "Permute only attention query rows at readout with seed 2333+query_count; use the same permutation across samples/heads of a scale. Preserve each sample/head row set and spatial mean, K/V and original query features/occupancies.",
